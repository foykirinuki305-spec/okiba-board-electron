{
  "author": "foykirinuki305-spec",
  "build": {
    "appId": "app.okibaboard.electron",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "package.json",
      "scripts/**"
    ],
    "portable": {
      "artifactName": "OkibaBoard.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "OkibaBoard-Setup-${version}.exe"
    },
    "productName": "OkibaBoard",
    "win": {
      "target": [
        {
          "arch": [
            "x64"
          ],
          "target": "nsis"
        },
        {
          "arch": [
            "x64"
          ],
          "target": "portable"
        }
      ]
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1"
        ]
      }
    ]
  },
  "description": "OkibaBoard — フォルダをデスクトップみたいに使えるボード (Electron版)",
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "playwright": "^1.49.1"
  },
  "license": "MIT",
  "main": "main.js",
  "name": "okiba-board",
  "scripts": {
    "build": "electron-builder --win --publish never",
    "selftest": "node tools/selftest.js",
    "test:gui": "node tests/gui.e2e.js",
    "start": "electron ."
  },
  "version": "2.0.0"
}